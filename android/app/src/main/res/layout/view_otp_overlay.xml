<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width card at the top of the screen, styled like an Android
     heads-up notification. Colors: res/values{,-night}/overlay_colors.xml.
     Row 1: icon, sender, close. Row 2: the code (large) and Copy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/overlayCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_pill"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_overlay_icon"
                android:contentDescription="@null"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_overlay_key" />

            <TextView
                android:id="@+id/overlaySender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Sender"
                android:textColor="@color/overlay_text_muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/overlayClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Dismiss"
                android:focusable="true"
                android:scaleType="center"
                android:src="@drawable/ic_overlay_close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <!-- Shrinks from 40sp down to 24sp only if a long code does not fit. -->
            <TextView
                android:id="@+id/overlayCode"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="123456"
                android:textColor="@color/overlay_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayCopyButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_copy_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="96dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Copy"
                android:textColor="@color/overlay_on_accent"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
